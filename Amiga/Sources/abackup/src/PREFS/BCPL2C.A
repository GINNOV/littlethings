;
;	VOID BCPL2C (BYTE *Bstr,BYTE *Cstr)
;
;	Converts a BCPL string into a C string
;

	CSECT	text
	XDEF	_BCPL2C

_BCPL2C:
	move.l	4(sp),a0                ; a0 = Bstr
	move.l	8(sp),a1                ; a1 = Cstr
	moveq	#0,d0			; d0 = string length
	move.b	(a0)+,d0
	beq.s	_b2c_end
	subq.l	#1,d0

_b2c_loop:
	move.b	(a0)+,(a1)+             ; copies next byte
	dbra	d0,_b2c_loop

_b2c_end:
	moveq	#0,d0			; add null byte
	MOVE.B	d0,(a1)
	RTS

	END
