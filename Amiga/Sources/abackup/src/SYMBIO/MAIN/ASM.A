MAXDATA 	EQU	511
;
		CSECT	TEXT
;
;=========================================================================
;
; UBYTE GetChkSum( UBYTE *pData )
;	Computes and returns the checksum of the given data block

_GetChkSum:
		move.l	4(sp),a0                ; get pData
		moveq	#0,d0			; clear checksum
		move.l	#MAXDATA-1,d1		; set byte count
_gcs_loop:
		add.b	(a0)+,d0                ; just add all bytes in d0
		dbra	d1,_gcs_loop
		rts
;
;=========================================================================
;
; void B2CStr( BYTE *pBStr , BYTE *pCStr )
;	Convert a BCPL string into a C string
;
_B2CStr:
		move.l	4(sp),a0                ; a0 = pBStr
		move.l	8(sp),a1                ; a1 = pCStr
		moveq	#0,d0			; d0 = string len
		move.b	(a0)+,d0
		beq.s	_b2c_end
		subq.l	#1,d0
_b2c_loop:
		move.b	(a0)+,(a1)+             ; copies next byte
		dbra	d0,_b2c_loop
_b2c_end:
		moveq	#0,d0			; add null byte
		move.b	d0,(a1)
		rts
;
;=========================================================================
;
		XDEF	_GetChkSum
		XDEF	_B2CStr
		END

