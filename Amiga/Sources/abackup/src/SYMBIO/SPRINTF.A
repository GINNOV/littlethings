;    Modified: 11-Feb-94
;    _______________________________________________________________________
;
;    NOTE(Reza): This version of sprintf uses exec.library/RawDoFmt()
;
;    Advantages: patched by locale.library which adds %U and %D formatting
;                commands for localized number output
;
;    Drawbacks : has fewer formatting commands than SAS/C sprintf()
;

	CSECT	text

	XDEF	_SPrintf

_SPrintf:
	MOVEM.L	a2/a3/a6,-(sp)		; save registers
	MOVE.L	 4+12(sp),a3		; put stack arguments into registers
	MOVE.L	 8+12(sp),a0
	LEA	12+12(sp),a1
	LEA	putchar(pc),a2		; and putchar routine
	MOVE.L	4,a6			; load SysBase
	JSR	-522(a6)		; RawDoFmt
	MOVEM.L	(sp)+,a2/a3/a6		; restore registers
	RTS

putchar:
	MOVE.B	d0,(a3)+
	RTS

	END
