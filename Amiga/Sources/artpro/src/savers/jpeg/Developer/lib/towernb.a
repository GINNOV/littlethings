	SECTION	text,CODE

	XDEF	_NewExtObject
	XDEF	_NewExtObjectA
	XDEF	@NewExtObjectA
	XDEF	_DisposeExtObject
	XDEF	@DisposeExtObject

	XREF	_TowerBase


_LVONewExtObjectA	EQU	-36
_LVODisposeExtObject	EQU	-42


_NewExtObject:
	lea	4(SP),A1
	move.l	(A1)+,A0
	bra.b	@NewExtObjectA
_NewExtObjectA:
	movem.l	4(SP),A0/A1
@NewExtObjectA:
	move.l	A6,-(SP)
	move.l	_TowerBase,A6
	jsr	_LVONewExtObjectA(A6)
	move.l	(SP)+,A6
	rts


_DisposeExtObject:
	move.l	4(SP),A0
@DisposeExtObject:
	move.l	A6,-(SP)
	move.l	_TowerBase,A6
	jsr	_LVODisposeExtObject(A6)
	move.l	(SP)+,A6
	rts


	END



