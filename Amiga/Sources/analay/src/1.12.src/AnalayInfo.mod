VAR analaydata   : UNTRACED POINTER TO AnalayData;
    analysisdata : UNTRACED POINTER TO AnalysisData;
    analayimg,
    analysisimg  : I.ImagePtr;
    infoId     * : INTEGER;

PROCEDURE Information*(screen:I.ScreenPtr);

VAR wind      : I.WindowPtr;
    rast      : g.RastPortPtr;
    ok        : I.GadgetPtr;
    width,
    x,y,wi,
    he        : INTEGER;
    class     : LONGSET;
    code      : INTEGER;
    address   : s.ADDRESS;
    bool,
    isOk      : BOOLEAN;
    sec1,mic1,
    sec2,mic2 : LONGINT;

PROCEDURE WriteString(x,y:INTEGER;str:e.STRPTR;dowrite:BOOLEAN);

VAR wi : INTEGER;

BEGIN
  wi:=g.TextLength(rast,str^,st.Length(str^));
  IF wi>width THEN
    width:=wi;
  END;
  IF dowrite THEN
    tt.Print(x,y,str,rast);
  END;
END WriteString;

PROCEDURE WriteText(dowrite:BOOLEAN);

VAR str     : ARRAY 80 OF CHAR;
    pos,i,a : INTEGER;

BEGIN
  WriteString(20,60,s.ADR("© 1995 Marc Necker"),dowrite);
  WriteString(20,70,ac.GetString(ac.AllRightsReserved),dowrite);

  IF kf.demo THEN
(*    WriteString(20,95,s.ADR("This is a beta-test-version which"),dowrite);
    WriteString(20,105,s.ADR("may not be spread or copied in any way!"),dowrite);*)
    WriteString(20,95,ac.GetString(ac.ThisIsADemo1),dowrite);
    WriteString(20,105,ac.GetString(ac.ThisIsADemo2),dowrite);
  ELSE
    WriteString(20,85,ac.GetString(ac.ThisVersionIsRegisteredTo),dowrite);
    i:=0;
    a:=0;
    pos:=0;
    WHILE pos<=st.Length(kf.name) DO
      IF (kf.name[pos]#",") AND (kf.name[pos]#0X) THEN
        str[i]:=kf.name[pos];
      ELSE
        str[i]:=0X;
        WriteString(20,99+a*10,s.ADR(str),dowrite);
        i:=-1;
        INC(pos);
        INC(a);
        IF a>=3 THEN
          pos:=SHORT(st.Length(kf.name));
        END;
      END;
      INC(pos);
      INC(i);
    END;
  END;
END WriteText;

BEGIN
  rast:=s1.window.rPort;
  width:=160+4*8;
  WriteText(FALSE);
  IF infoId=-1 THEN
    infoId:=wm.InitWindow(20,20,width+40,148,s.ADR("Analay V1.1"),LONGSET{I.activate,I.windowDrag,I.windowDepth},LONGSET{I.menuPick,I.rawKey,I.gadgetDown,I.gadgetUp,I.mouseButtons},s1.screen,FALSE);
  END;
  wm.GetDimensions(infoId,x,y,wi,he);
  wm.SetDimensions(infoId,x,y,width+40+148+10,148);
  gm.StartGadgets(s1.window);
  ok:=gm.SetBooleanGadget(14,127,width+40+148+10-28,14,ac.GetString(ac.OK));
  gm.EndGadgets;
  wm.ChangeScreen(infoId,screen);
  wind:=wm.OpenMultiWindow(infoId,ok);
  IF wind#NIL THEN
    rast:=wind.rPort;

    it.DrawBorder(rast,14,16,width+40+148+10-28,108);

    IF NOT(kf.demo) THEN
      bool:=kf.CheckKeyFile(isOk,kf.keystr,kf.name,kf.userId);
      IF NOT(bool) OR NOT(isOk) THEN
        HALT(20);
      END;
    END;

    g.SetAPen(rast,1);
    g.RectFill(rast,20+width+14,21,20+width+14+143,21+99);
    I.DrawImage(rast,analayimg^,20,19);
    g.SetDrMd(rast,g.jam1);
    g.SetAPen(rast,1);
    tt.Print(164,48,s.ADR("V1.1"),rast);
    g.SetAPen(rast,2);
    tt.Print(162,47,s.ADR("V1.1"),rast);
    WriteText(TRUE);
    IF kf.demo THEN
      I.CurrentTime(sec2,mic2);
      FOR y:=1 TO 100 DO
        sec1:=sec2;
        mic1:=mic2;
        analysisimg.height:=y;
        I.DrawImage(rast,analysisimg^,20+width+10,19);
        d.Delay(10);
        REPEAT
          I.CurrentTime(sec2,mic2);
        UNTIL (mic2-mic1>=200000) OR (sec2>sec1);
      END;
    END;
    analysisimg.height:=100;
    I.DrawImage(rast,analysisimg^,20+width+10,19);

    LOOP
      e.WaitPort(wind.userPort);
      it.GetIMes(wind,class,code,address);
      IF I.gadgetUp IN class THEN
        IF address=ok THEN
          EXIT;
        END;
      END;
    END;

    wm.CloseMultiWindow(infoId,wind);
  END;
  gm.FreeGadgetList(ok);
END Information;

BEGIN
  infoId:=-1;

  analaydata:=e.AllocMem(620*2,LONGSET{e.memClear,e.chip});
  analysisdata:=e.AllocMem(1800*2,LONGSET{e.memClear,e.chip});

  e.CopyMem(analay,analaydata^,LEN(analaydata^)*2);
  e.CopyMem(analysis,analysisdata^,LEN(analysisdata^)*2);

  NEW(analayimg);
  analayimg.leftEdge:=0;
  analayimg.topEdge:=0;
  analayimg.width:=160;
  analayimg.height:=31;
  analayimg.depth:=2;
  analayimg.imageData:=analaydata;
  analayimg.planePick:=SHORTSET{0,1};
  analayimg.planeOnOff:=SHORTSET{};
  analayimg.nextImage:=NIL;

  NEW(analysisimg);
  analysisimg.leftEdge:=0;
  analysisimg.topEdge:=0;
  analysisimg.width:=144;
  analysisimg.height:=100;
  analysisimg.depth:=2;
  analysisimg.imageData:=analysisdata;
  analysisimg.planePick:=SHORTSET{0,1};
  analysisimg.planeOnOff:=SHORTSET{};
  analysisimg.nextImage:=NIL;
CLOSE
  IF analayimg#NIL THEN
    DISPOSE(analayimg);
  END;
  IF analysisimg#NIL THEN
    DISPOSE(analysisimg);
  END;
  IF analaydata#NIL THEN
    e.FreeMem(analaydata,LEN(analaydata^)*2);
  END;
  IF analysisdata#NIL THEN
    e.FreeMem(analysisdata,LEN(analysisdata^)*2);
  END;
END AnalayInfo.

