PROCEDURE AllocAnalysisImage*():Image;

VAR data : Image;

BEGIN
  data:=e.AllocMem(1800*2,LONGSET{e.memClear,e.chip});
  e.CopyMem(analysis,data^,1800*2);

  RETURN data;
END AllocAnalysisImage;

PROCEDURE AllocAnalysisIntuiImage*(analysisdata:Image):I.ImagePtr;

VAR analayimg : I.ImagePtr;

BEGIN
  NEW(analayimg);
  analayimg.leftEdge:=0;
  analayimg.topEdge:=0;
  analayimg.width:=144;
  analayimg.height:=100;
  analayimg.depth:=2;
  analayimg.imageData:=analysisdata;
  analayimg.planePick:=SHORTSET{0,1};
  analayimg.planeOnOff:=SHORTSET{};
  analayimg.nextImage:=NIL;

  RETURN analayimg;
END AllocAnalysisIntuiImage;



VAR pointerimg     * ,
    pointerselimg  * ,
    cursorimg      * ,
    cursorselimg   * ,
    glassimg       * ,
    glassselimg    * ,
    depthimg       * ,
    depthselimg    * ,
    textimg        * ,
    textselimg     * ,
    deleteimg      * ,
    deleteselimg   * ,
    textlineimg    * ,
    textlineselimg * ,
    lineimg        * ,
    lineselimg     * ,
    rectimg        * ,
    rectselimg     * ,
    circleimg      * ,
    circleselimg   * ,
    analayimg      * ,
    analysisimg    * : Image;
    analayimage    * ,
    analysisimage  * : I.ImagePtr;

PROCEDURE AllocImages;

BEGIN
  pointerimg:=AllocPointerImage();
  pointerselimg:=AllocPointerImage();
  InvertImage(pointerselimg);
  cursorimg:=AllocCursorImage();
  cursorselimg:=AllocCursorImage();
  InvertImage(cursorselimg);
  glassimg:=AllocGlassImage();
  glassselimg:=AllocGlassImage();
  InvertImage(glassselimg);
  depthimg:=AllocDepthImage();
  depthselimg:=AllocDepthImage();
  InvertImage(depthselimg);
  textimg:=AllocTextImage();
  textselimg:=AllocTextImage();
  InvertImage(textselimg);
  deleteimg:=AllocDeleteImage();
  deleteselimg:=AllocDeleteImage();
  InvertImage(deleteselimg);
  textlineimg:=AllocTextLineImage();
  textlineselimg:=AllocTextLineImage();
  InvertImage(textlineselimg);
  lineimg:=AllocLineImage();
  lineselimg:=AllocLineImage();
  InvertImage(lineselimg);
  rectimg:=AllocRectangleImage();
  rectselimg:=AllocRectangleImage();
  InvertImage(rectselimg);
  circleimg:=AllocCircleImage();
  circleselimg:=AllocCircleImage();
  InvertImage(circleselimg);

  analayimg:=AllocAnalayImage();
  analayimage:=AllocAnalayIntuiImage(analayimg);
  analysisimg:=AllocAnalysisImage();
  analysisimage:=AllocAnalysisIntuiImage(analysisimg);
END AllocImages;

PROCEDURE DestructImages;

BEGIN
  DestructImage(pointerimg,32,19,2);
  DestructImage(pointerselimg,32,19,2);
  DestructImage(cursorimg,32,19,2);
  DestructImage(cursorselimg,32,19,2);
  DestructImage(glassimg,32,19,2);
  DestructImage(glassselimg,32,19,2);
  DestructImage(depthimg,32,19,2);
  DestructImage(depthselimg,32,19,2);
  DestructImage(textimg,32,19,2);
  DestructImage(textselimg,32,19,2);
  DestructImage(deleteimg,32,19,2);
  DestructImage(deleteselimg,32,19,2);
  DestructImage(textlineimg,32,19,2);
  DestructImage(textlineselimg,32,19,2);
  DestructImage(lineimg,32,19,2);
  DestructImage(lineselimg,32,19,2);
  DestructImage(rectimg,32,19,2);
  DestructImage(rectselimg,32,19,2);
  DestructImage(circleimg,32,19,2);
  DestructImage(circleselimg,32,19,2);

  e.FreeMem(analayimg,620*2);
  DISPOSE(analayimage);
  e.FreeMem(analysisimg,1800*2);
  DISPOSE(analysisimage);
END DestructImages;

BEGIN
  AllocImages;
CLOSE
  DestructImages;
END Images.

