PROCEDURE AllocAnalayImage*():Image;

VAR data : Image;

BEGIN
  data:=e.AllocMem(620*2,LONGSET{e.memClear,e.chip});
  e.CopyMem(analay,data^,620*2);

  RETURN data;
END AllocAnalayImage;

PROCEDURE AllocAnalayIntuiImage*(analaydata:Image):I.ImagePtr;

VAR analayimg : I.ImagePtr;

BEGIN
  NEW(analayimg);
  analayimg.leftEdge:=0;
  analayimg.topEdge:=0;
  analayimg.width:=160;
  analayimg.height:=31;
  analayimg.depth:=2;
  analayimg.imageData:=analaydata;
  analayimg.planePick:=SHORTSET{0,1};
  analayimg.planeOnOff:=SHORTSET{};
  analayimg.nextImage:=NIL;

  RETURN analayimg;
END AllocAnalayIntuiImage;

