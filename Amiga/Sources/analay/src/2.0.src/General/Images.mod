PROCEDURE DestructImage*(VAR image:Image;width,height,depth:INTEGER);
(* width = width in pixels, must be multiple of 8. *)

BEGIN
  e.FreeMem(image,(width DIV 8)*height*(depth DIV 2)*s.SIZE(INTEGER));
END DestructImage;

PROCEDURE InvertImage*(VAR image:Image);

VAR i,a : INTEGER;
    set : SET;

BEGIN
  FOR i:=0 TO 75 DO
    set:=s.VAL(SET,image[i]);
    FOR a:=0 TO 15 DO
      IF a IN set THEN
        EXCL(set,a);
      ELSE
        INCL(set,a);
      END;
    END;
    image[i]:=s.VAL(INTEGER,set);
  END;
END InvertImage;

