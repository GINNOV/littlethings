MODULE Images;

IMPORT I  : Intuition,
       g  : Graphics,
       e  : Exec,
       s  : SYSTEM,
       NoGuruRq;

TYPE Image * = UNTRACED POINTER TO ARRAY MAX(INTEGER) OF INTEGER; (* was: UNTRACED POINTER TO ARRAY 76 OF INTEGER *)

