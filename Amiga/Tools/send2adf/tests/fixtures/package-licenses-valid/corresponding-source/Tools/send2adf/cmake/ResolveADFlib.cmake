include(FetchContent)

function(send2adf_resolve_adflib)
    get_filename_component(_canonical_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../build-support/adflib/ADFlibDependency.cmake" ABSOLUTE)
    if(DEFINED ADFLIB_MANIFEST_FILE)
        get_filename_component(_selected_manifest "${ADFLIB_MANIFEST_FILE}" ABSOLUTE)
    else()
        set(_selected_manifest "${_canonical_manifest}")
    endif()
    if(NOT _selected_manifest STREQUAL _canonical_manifest AND NOT SEND2ADF_TESTING)
        message(FATAL_ERROR "noncanonical_adflib_manifest_rejected")
    endif()
    if(ADFLIB_CANARY AND NOT SEND2ADF_TESTING)
        message(FATAL_ERROR "canary_dependency_rejected_for_production")
    endif()
    include("${_selected_manifest}")
    set(_identity_channel "stable")
    if(ADFLIB_CANARY)
        foreach(_required ADFLIB_CANARY_COMMIT ADFLIB_CANARY_TREE_SHA ADFLIB_CANARY_ARCHIVE_URL ADFLIB_CANARY_TREE_MANIFEST_SHA256 ADFLIB_CANARY_TRANSPORT_SHA256)
            if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
                message(FATAL_ERROR "canary_identity_incomplete:${_required}")
            endif()
        endforeach()
        string(LENGTH "${ADFLIB_CANARY_COMMIT}" _commit_length)
        string(LENGTH "${ADFLIB_CANARY_TREE_SHA}" _tree_length)
        string(LENGTH "${ADFLIB_CANARY_TREE_MANIFEST_SHA256}" _tree_manifest_length)
        string(LENGTH "${ADFLIB_CANARY_TRANSPORT_SHA256}" _transport_length)
        if(NOT _commit_length EQUAL 40 OR NOT ADFLIB_CANARY_COMMIT MATCHES "^[0-9a-f]+$" OR NOT _tree_length EQUAL 40 OR NOT ADFLIB_CANARY_TREE_SHA MATCHES "^[0-9a-f]+$" OR NOT _tree_manifest_length EQUAL 64 OR NOT ADFLIB_CANARY_TREE_MANIFEST_SHA256 MATCHES "^[0-9a-f]+$" OR NOT _transport_length EQUAL 64 OR NOT ADFLIB_CANARY_TRANSPORT_SHA256 MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "canary_identity_invalid")
        endif()
        set(_expected_canary_url "https://github.com/adflib/ADFlib/archive/${ADFLIB_CANARY_COMMIT}.tar.gz")
        if(NOT ADFLIB_CANARY_ARCHIVE_URL STREQUAL _expected_canary_url)
            message(FATAL_ERROR "canary_archive_url_invalid")
        endif()
        set(ADFLIB_VERSION "0.0.0-canary")
        set(ADFLIB_TAG "master")
        set(ADFLIB_COMMIT "${ADFLIB_CANARY_COMMIT}")
        set(ADFLIB_TREE_SHA "${ADFLIB_CANARY_TREE_SHA}")
        set(ADFLIB_ARCHIVE_URL "${ADFLIB_CANARY_ARCHIVE_URL}")
        set(ADFLIB_TREE_MANIFEST_SHA256 "${ADFLIB_CANARY_TREE_MANIFEST_SHA256}")
        set(ADFLIB_EXPECTED_TRANSPORT_SHA256 "${ADFLIB_CANARY_TRANSPORT_SHA256}")
        if(DEFINED ADFLIB_SYMLINK_ALLOWLIST AND NOT ADFLIB_SYMLINK_ALLOWLIST STREQUAL "")
            set(ADFLIB_SYMLINK_ALLOWLIST_COMMIT "${ADFLIB_COMMIT}")
            set(ADFLIB_SYMLINK_ALLOWLIST_TREE_SHA "${ADFLIB_TREE_SHA}")
        endif()
        set(ADFLIB_MATERIALIZATION_SOURCE_TREE_MANIFEST_SHA256 "")
        set(_effective_manifest "${CMAKE_BINARY_DIR}/ADFlibCanaryDependency.cmake")
        file(WRITE "${_effective_manifest}"
            "set(ADFLIB_CHANNEL \"canary\")\n"
            "set(ADFLIB_OWNER_REPO \"${ADFLIB_OWNER_REPO}\")\n"
            "set(ADFLIB_VERSION \"${ADFLIB_VERSION}\")\n"
            "set(ADFLIB_TAG \"${ADFLIB_TAG}\")\n"
            "set(ADFLIB_COMMIT \"${ADFLIB_COMMIT}\")\n"
            "set(ADFLIB_TREE_SHA \"${ADFLIB_TREE_SHA}\")\n"
            "set(ADFLIB_ARCHIVE_URL \"${ADFLIB_ARCHIVE_URL}\")\n"
            "set(ADFLIB_TREE_MANIFEST_SHA256 \"${ADFLIB_TREE_MANIFEST_SHA256}\")\n"
            "set(ADFLIB_PATCH_SHA256 \"${ADFLIB_PATCH_SHA256}\")\n"
            "set(ADFLIB_EXPECTED_TRANSPORT_SHA256 \"${ADFLIB_EXPECTED_TRANSPORT_SHA256}\")\n"
            "set(ADFLIB_SYMLINK_ALLOWLIST_COMMIT \"${ADFLIB_SYMLINK_ALLOWLIST_COMMIT}\")\n"
            "set(ADFLIB_SYMLINK_ALLOWLIST_TREE_SHA \"${ADFLIB_SYMLINK_ALLOWLIST_TREE_SHA}\")\n"
            "set(ADFLIB_SYMLINK_ALLOWLIST \"${ADFLIB_SYMLINK_ALLOWLIST}\")\n"
        )
        set(_selected_manifest "${_effective_manifest}")
        set(_identity_channel "canary")
    endif()

    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    set(_stager "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../build-support/adflib/stage_adflib.py")
    set(_patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../build-support/adflib/patches/0001-cmake-disable-examples.patch")
    set(_stage "${CMAKE_BINARY_DIR}/adflib-${ADFLIB_COMMIT}-stage")
    file(REMOVE_RECURSE "${_stage}")
    set(_command "${Python3_EXECUTABLE}" "${_stager}" --manifest "${_selected_manifest}" --patch "${_patch}" --stage "${_stage}" --print-source-root)
    if(FETCHCONTENT_FULLY_DISCONNECTED)
        if(NOT DEFINED FETCHCONTENT_SOURCE_DIR_ADF OR NOT IS_ABSOLUTE "${FETCHCONTENT_SOURCE_DIR_ADF}" OR NOT IS_DIRECTORY "${FETCHCONTENT_SOURCE_DIR_ADF}")
            message(FATAL_ERROR "offline_adflib_source_must_be_absolute_directory")
        endif()
        list(APPEND _command --source-root "${FETCHCONTENT_SOURCE_DIR_ADF}")
        set(_pristine "${FETCHCONTENT_SOURCE_DIR_ADF}")
    else()
        list(APPEND _command --connected --artifacts "${CMAKE_BINARY_DIR}/adflib-cache")
        set(_pristine "${CMAKE_BINARY_DIR}/adflib-cache/ADFlib-${ADFLIB_COMMIT}-pristine")
    endif()
    execute_process(COMMAND ${_command} RESULT_VARIABLE _stage_result OUTPUT_VARIABLE _stage_output ERROR_VARIABLE _stage_error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _stage_result EQUAL 0)
        message(FATAL_ERROR "${_stage_error}")
    endif()
    if(NOT _stage_output STREQUAL _stage)
        get_filename_component(_stage_real "${_stage}" REALPATH)
        if(NOT _stage_output STREQUAL _stage_real)
            message(FATAL_ERROR "adflib_stage_path_mismatch")
        endif()
    endif()

    foreach(_variable BUILD_SHARED_LIBS ADFLIB_ENABLE_NATIVE_DEV ADFLIB_ENABLE_TESTS ADFLIB_ENABLE_EXAMPLES)
        if(DEFINED ${_variable})
            set(_saved_${_variable}_defined TRUE)
            set(_saved_${_variable} "${${_variable}}")
        else()
            set(_saved_${_variable}_defined FALSE)
        endif()
        set(${_variable} OFF CACHE BOOL "send2adf pinned ADFlib setting" FORCE)
    endforeach()

    FetchContent_Declare(adf_verified SOURCE_DIR "${_stage}")
    FetchContent_GetProperties(adf_verified)
    if(NOT adf_verified_POPULATED)
        cmake_policy(PUSH)
        if(POLICY CMP0169)
            cmake_policy(SET CMP0169 OLD)
        endif()
        FetchContent_Populate(adf_verified)
        cmake_policy(POP)
    endif()
    add_subdirectory("${adf_verified_SOURCE_DIR}" "${adf_verified_BINARY_DIR}" EXCLUDE_FROM_ALL)
    if(NOT TARGET adf)
        message(FATAL_ERROR "adflib_target_missing")
    endif()
    foreach(_forbidden adfbitmap adfformat adfimgcreate adfinfo adfls adfsalvage unadf)
        if(TARGET ${_forbidden})
            message(FATAL_ERROR "adflib_examples_enabled:${_forbidden}")
        endif()
    endforeach()

    foreach(_variable BUILD_SHARED_LIBS ADFLIB_ENABLE_NATIVE_DEV ADFLIB_ENABLE_TESTS ADFLIB_ENABLE_EXAMPLES)
        if(_saved_${_variable}_defined)
            set(${_variable} "${_saved_${_variable}}" CACHE BOOL "restored caller setting" FORCE)
        else()
            unset(${_variable} CACHE)
        endif()
    endforeach()

    set(SEND2ADF_ADFLIB_IDENTITY "{\"channel\":\"${_identity_channel}\",\"owner_repo\":\"${ADFLIB_OWNER_REPO}\",\"version\":\"${ADFLIB_VERSION}\",\"tag\":\"${ADFLIB_TAG}\",\"commit\":\"${ADFLIB_COMMIT}\",\"tree_sha\":\"${ADFLIB_TREE_SHA}\",\"url\":\"${ADFLIB_ARCHIVE_URL}\",\"tree_manifest_sha256\":\"${ADFLIB_TREE_MANIFEST_SHA256}\"}" PARENT_SCOPE)
    get_filename_component(_pristine_parent "${_pristine}" DIRECTORY)
    set(_transport_record "${_pristine_parent}/adflib-transport.json")
    if(EXISTS "${_transport_record}")
        file(READ "${_transport_record}" _transport_json)
        string(JSON _transport_url GET "${_transport_json}" transport_url)
        string(JSON _transport_sha256 GET "${_transport_json}" transport_sha256)
        string(JSON _local_cache_sha256 GET "${_transport_json}" local_cache_sha256)
    elseif(_identity_channel STREQUAL "canary")
        set(_transport_url "https://codeload.github.com/adflib/ADFlib/tar.gz/${ADFLIB_COMMIT}")
        set(_transport_sha256 "${ADFLIB_CANARY_TRANSPORT_SHA256}")
        set(_local_cache_sha256 "runtime-verified")
    else()
        set(_transport_url "${ADFLIB_TRANSPORT_URL}")
        set(_transport_sha256 "${ADFLIB_TRANSPORT_SHA256}")
        set(_local_cache_sha256 "${ADFLIB_LOCAL_CACHE_SHA256}")
    endif()
    set(SEND2ADF_ADFLIB_TRANSPORT "{\"transport_url\":\"${_transport_url}\",\"transport_sha256\":\"${_transport_sha256}\",\"local_cache_sha256\":\"${_local_cache_sha256}\"}" PARENT_SCOPE)
    set(SEND2ADF_ADFLIB_COMMIT "${ADFLIB_COMMIT}" PARENT_SCOPE)
    set(SEND2ADF_ADFLIB_PRISTINE_ROOT "${_pristine}" PARENT_SCOPE)
    set(SEND2ADF_ADFLIB_MANIFEST "${_selected_manifest}" PARENT_SCOPE)
    set(Python3_EXECUTABLE "${Python3_EXECUTABLE}" PARENT_SCOPE)
endfunction()
