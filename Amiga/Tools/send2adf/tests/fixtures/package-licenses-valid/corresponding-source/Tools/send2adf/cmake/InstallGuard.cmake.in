if("@SEND2ADF_TESTING@" STREQUAL "ON")
    message(FATAL_ERROR "install_from_testing_configuration_rejected")
endif()
if("@ADFLIB_CANARY@" STREQUAL "ON")
    message(FATAL_ERROR "install_from_canary_configuration_rejected")
endif()
get_filename_component(_configured_manifest "@SEND2ADF_ADFLIB_MANIFEST@" REALPATH)
get_filename_component(_canonical_manifest "@CMAKE_CURRENT_SOURCE_DIR@/../build-support/adflib/ADFlibDependency.cmake" REALPATH)
if(NOT _configured_manifest STREQUAL _canonical_manifest)
    message(FATAL_ERROR "install_from_noncanonical_manifest_rejected")
endif()
