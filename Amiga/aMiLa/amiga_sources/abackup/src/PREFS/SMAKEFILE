.SILENT:

# macros:
#--------
INC = syms.h id.h macros.h io.h prefs.h protos.h globals.h locale.h
OBJ = obj/main.o	\
      obj/handle.o      \
      obj/setup.o       \
      obj/locale.o      \
      obj/io.o  	\
      obj/getclass.o    \
      obj/fillclass.o   \
      obj/gadgets.o     \
      obj/menus.o       \
      obj/update.o      \
      obj/windows.o     \
      obj/xpk.o 	\
      obj/requester.o   \
      obj/utility.o     \
      obj/scsi.o	\
      obj/cleanup.o     \
      obj/sprintf.o     \
      obj/bcpl2c.o

# build all:
#-----------
abackup: abprefs.gst locale.h $(OBJ)
	echo "  linking $@ preferences..."
	$(LD) QUIET FROM lib:c.o $(OBJ) TO $@\
	LIB lib:sc.lib WITH lib:utillib.with # NODEBUG
	protect $@ +a

# delete all:
#-----------
clean:
	echo "  deleting object files..."
	delete obj/\#? QUIET

# build GST file:
#----------------
abprefs.gst: syms.h
	echo "  generating global symbol table..."
	$(CC) $< MGST $@ NOOBJNAME
	protect $@ +ah

# build locales:
#---------------
locale.h: locale/abprefs.cd
	echo "  generating locale strings..."
	catcomp $< CFILE $@ NOARRAY NOCODE

# compile:
#---------
.c.o:
	echo "  compiling $*.c"
	$(CC) $*.c
.a.o:
	echo "  assembling $*.a"
	$(AS) -oobj/ $*

# object files rules:
#--------------------
obj/main.o     : main.c 	$(INC) main.h
obj/handle.o   : handle.c       $(INC)
obj/setup.o    : setup.c	$(INC) template.h setup.h
obj/locale.o   : locale.c       $(INC)
obj/io.o       : io.c   	$(INC) icon.h
obj/getclass.o : getclass.c     $(INC) getclass.h
obj/fillclass.o: fillclass.c    $(INC) fillclass.h
obj/gadgets.o  : gadgets.c      $(INC)
obj/menus.o    : menus.c	$(INC) menus.h
obj/update.o   : update.c       $(INC)
obj/windows.o  : windows.c      $(INC) gadgets.h windows.h
obj/xpk.o      : xpk.c  	$(INC) xpk.h
obj/requester.o: requester.c    $(INC) requester.h
obj/utility.o  : utility.c      $(INC) utility.h
obj/scsi.o     : scsi.c 	$(INC) scsi.h
obj/cleanup.o  : cleanup.c      $(INC)

obj/sprintf.o  : /symbio/sprintf.a
obj/bcpl2c.o   : bcpl2c.a

# create hypertext reference:
#----------------------------
refs:
	echo "  generating reference file to functions..."
	mkproto *.c STATIC HYPER HWIDTH 22 HCOL 3 TO $@.guide
