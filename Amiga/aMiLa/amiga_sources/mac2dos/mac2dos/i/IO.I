ADCMD_PERVOL            EQU     CMD_NONSTD+3
ADCMD_LOCK              EQU     CMD_NONSTD+4
ADCMD_WAITCYCLE         EQU     CMD_NONSTD+5
ADCMDB_NOUNIT           EQU     5
ADCMDF_NOUNIT           EQU     1<<5
ADCMD_ALLOCATE          EQU     ADCMDF_NOUNIT+0
ADIOB_PERVOL            EQU     4
ADIOF_PERVOL            EQU     1<<4
