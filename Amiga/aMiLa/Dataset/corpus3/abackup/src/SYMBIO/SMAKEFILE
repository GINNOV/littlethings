obj/dirtree.o   : main/dirtree.c	$(INC) locale.h
obj/floppy.o    : main/floppy.c 	$(INC) locale.h
obj/io.o	: main/io.c     	$(INC) locale.h  main/childtask.h
obj/newfmt.o    : main/newfmt.c 	$(INC) locale.h
