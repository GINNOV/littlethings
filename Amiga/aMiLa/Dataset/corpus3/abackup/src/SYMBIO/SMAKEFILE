.SILENT:

# macros:
---------
INC =   syms.h macros.h protos.h globals.h defines.h objects.h args.h\
	/prefs/prefs.h main/oldfmt.h main/select.h

GENE=   obj/main.o obj/main2.o obj/setup.o obj/getargs.o obj/cleanup.o obj/locale.o\
	obj/batch.o obj/icon.o obj/userom.o
GUI =   obj/bitrequest.o obj/display.o obj/fonts.o obj/menus.o obj/gadgets.o\
	obj/monitor.o obj/requesters.o obj/screen.o obj/selection.o obj/utility.o\
	obj/windows.o
MAIN=   obj/audio.o obj/archive.o obj/avl.o obj/badcyl.o obj/childtask.o\
	obj/compress.o obj/convert.o obj/crypt.o obj/device.o obj/dirtree.o\
	obj/floppy.o obj/io.o obj/newfmt.o obj/objects.o obj/oldfmt.o obj/rdb.o\
	obj/rebuild.o obj/report.o obj/restore.o obj/save.o obj/select.o obj/tape.o\
	obj/utils.o obj/verify.o
ASM =   obj/asm.o obj/sprintf.o
OBJS=   $(GENE) $(GUI) $(MAIN) $(ASM)

# build all:
------------
abackup: abackup.with abackup.gst locale.h $(OBJS)
	echo "  linking $@..."
	$(LD) QUIET FROM lib:c.o TO $@ WITH $@.with
	protect $@ +a

# build GST file:
#----------------
abackup.gst: syms.h userom.h
	echo "  generating the global symbol table..."
	$(CC) $< MGST $@ NOOBJNAME IGNORE=84
	protect $@ +ah

# build locales:
#---------------
locale.h: locale/abackup.cd
	echo "  generating locale strings..."
	catcomp $< CFILE $@ NOARRAY NOCODE

# compile:
#---------
.c.o:
	echo "  compiling" $*.c...
	$(CC) $*.c
.a.o:
	echo "  assembling" $*.a...
	$(AS) -oobj/ $*

# erase objects:
#---------------
clean:
	echo "  deleting all object files..."
	- delete obj/* QUIET

# objects rules:
#---------------
obj/main.o      : main.c		$(INC) locale.h gui/id.h main.h
obj/main2.o     : main2.c       	$(INC) locale.h gui/id.h main.h
