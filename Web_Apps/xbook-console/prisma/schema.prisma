generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Bookmark {
  id               String            @id
  source           String            @default("x")
  tweetUrl         String
  text             String?
  authorName       String?
  authorUsername   String?
  createdAt        DateTime?
  likeCount        Int?
  replyCount       Int?
  retweetCount     Int?
  quoteCount       Int?
  lang             String?
  externalUrls     String?
  summary          String?
  category         String?
  tags             String?
  rawJson          String?
  folderId         String?
  importedAt       DateTime          @default(now())
  summarizedAt     DateTime?
  editedAt         DateTime?
  readAt           DateTime?
  mediaDescription String?
  mediaJson        String?
  embedding        Bytes?
  enrichmentError  String?
  enrichmentFailures Int           @default(0)
  folder           BookmarkFolder?   @relation(fields: [folderId], references: [id])
  llmRequestLogs   LlmRequestLog[]
  processingEvents ProcessingEvent[]
}

model ImportRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalFetched Int       @default(0)
  notes        String?
}

model BookmarkFolder {
  id        String     @id
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookmarks Bookmark[]
}

model Settings {
  id               String    @id @default("default")
  xBearerToken     String?
  xUserId          String?
  xApiBase         String?
  xClientId        String?
  xClientSecret    String?
  xRedirectUri     String?
  xAccessToken     String?
  xRefreshToken    String?
  xTokenExpiresAt  DateTime?
  xScope           String?
  xTokenType       String?
  ytClientId       String?
  ytClientSecret   String?
  ytRedirectUri    String?
  ytAccessToken    String?
  ytRefreshToken   String?
  ytTokenExpiresAt DateTime?
  ytScope          String?
  ytTokenType      String?
  llmBaseUrl       String?
  llmApiKey        String?
  llmModel         String?
  llmEmbeddingModel String?
  llmEmbeddingBaseUrl String?
  llmSystemPrompt  String?
  llmPrompt        String?
  monthlyCap       Int       @default(100)
  ytMonthlyCap     Int       @default(100)
  enrichBatchSize  Int       @default(50)
  llmConcurrency   Int       @default(1)
  llmMaxTokens     Int       @default(4000)
  llmContextWindow Int       @default(128000)
  llmResponseLimit Int       @default(2000)
  llmThinkingEnabled Boolean @default(false)
  targetLanguage   String    @default("English")
  logLlmPayloads   Boolean   @default(true)
  soundOnComplete  Boolean   @default(false)
  soundOnError     Boolean   @default(false)
  lastBookmarkId   String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OAuthSession {
  state        String   @id
  codeVerifier String
  createdAt    DateTime @default(now())
}

model UsageMonth {
  id            String   @id
  month         String
  source        String   @default("x")
  usedBookmarks Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model OperationRun {
  id          String            @id @default(cuid())
  type        String
  source      String?
  status      String            @default("queued")
  total       Int               @default(0)
  processed   Int               @default(0)
  updated     Int               @default(0)
  failed      Int               @default(0)
  skipped     Int               @default(0)
  notes       String?
  /// Snapshot of model / endpoint / knobs used for this run (JSON).
  configJson  String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
  llmRequests LlmRequestLog[]
  events      ProcessingEvent[]
}

model ProcessingEvent {
  id           String       @id @default(cuid())
  runId        String
  bookmarkId   String?
  type         String
  status       String
  message      String?
  metadataJson String?
  createdAt    DateTime     @default(now())
  bookmark     Bookmark?    @relation(fields: [bookmarkId], references: [id])
  run          OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([bookmarkId])
  @@index([status])
  @@index([createdAt])
}

model LlmRequestLog {
  id              String        @id @default(cuid())
  runId           String?
  bookmarkId      String?
  model           String?
  baseUrl         String?
  promptPreview   String?
  prompt          String?
  responsePreview String?
  response        String?
  parsedJson      String?
  durationMs      Int?
  tokenUsageJson  String?
  error           String?
  createdAt       DateTime      @default(now())
  bookmark        Bookmark?     @relation(fields: [bookmarkId], references: [id])
  run             OperationRun? @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([bookmarkId])
  @@index([createdAt])
}
