{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swift review receipt",
  "type": "object",
  "required": ["schemaVersion", "commitSHA", "reviewer", "promptSHA256", "skillSHA256", "transcript", "transcriptSHA256", "verdict", "verdictLine", "verdictLineSHA256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "commitSHA": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "reviewer": {"type": "string"},
    "promptSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "skillSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "transcript": {"type": "string"},
    "transcriptSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "verdictLine": {"const": "VERDICT: PASS"},
    "verdictLineSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"}
  },
  "additionalProperties": false
}
