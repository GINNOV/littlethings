{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual observation",
  "type": "object",
  "required": ["schemaVersion", "observer", "surface", "invocation", "observed", "hardwareUsed", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "observer": {"type": "string"},
    "surface": {"type": "string"},
    "invocation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hardwareUsed": {"const": false},
    "guiObserved": {"type": "boolean"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
