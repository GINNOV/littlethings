{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 1 parent evidence",
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "task", "parentRunID", "baseSHA", "preflightReceipt", "modes", "outcome"],
      "properties": {
        "schemaVersion": {"const": 1},
        "task": {"const": 1},
        "parentRunID": {"type": "string", "pattern": "[0-9a-f-]{36}"},
        "baseSHA": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "preflightReceipt": {"type": "object", "required": ["path", "sha256"]},
        "modes": {"type": "array", "minItems": 2, "maxItems": 2},
        "outcome": {"const": "PASS"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "task1IndexSHA256", "preflightSHA256", "baseSHA", "commitParent", "commitMessage", "commitSHA", "commitTree", "allowedDiff", "committedManifestSHA256", "preQAManifestSHA256", "manifestsEqual", "scopedStatusSHA256", "scopedStatusEmpty", "releasedAtMonotonic"],
      "properties": {
        "schemaVersion": {"const": 1},
        "task1IndexSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "preflightSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "parentSession": {"type": "string"},
        "parentPIDBirth": {"type": "object"},
        "baseSHA": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "commitParent": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "commitMessage": {"type": "string"},
        "commitSHA": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "commitTree": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "allowedDiff": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "committedManifestSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "preQAManifestSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "manifestsEqual": {"const": true},
        "scopedStatusSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "scopedStatusEmpty": {"const": true},
        "releasedAtMonotonic": {"type": "integer"}
      },
      "additionalProperties": false
    }
  ]
}
