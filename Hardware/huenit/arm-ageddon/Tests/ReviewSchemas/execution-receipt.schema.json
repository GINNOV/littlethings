{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Armageddon execution receipt",
  "type": "object",
  "required": ["schemaVersion", "kind"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"enum": ["build", "process-launch", "process-exit", "recorded-process-exit", "gate-release", "gui-lease", "task-execution"]},
    "parentRunID": {"type": "string", "pattern": "[0-9a-f-]{36}"},
    "childNonce": {"type": "string", "pattern": "[0-9a-f-]{36}"},
    "baseCommit": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "finalCommit": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "planSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "outcome": {"enum": ["PASS", "EXPECTED_FAILURE", "FAIL", "NOT_RUN_OPERATOR_REQUIRED"]},
    "liveIOObservation": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
      },
      "additionalProperties": false
    },
    "observedExecutable": {"type": "string"},
    "observedExecutableSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "intendedExecutable": {"type": "string"},
    "intendedExecutableSHA256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "postExecChild": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "task-execution"}}},
      "then": {"required": ["startMonotonicNs", "endMonotonicNs", "deviceOpenCount", "serialWriteCount", "liveIOObservation"]}
    },
    {
      "if": {"properties": {"kind": {"const": "process-launch"}}},
      "then": {"required": ["intendedExecutable", "intendedExecutableSHA256", "child", "preexecBarrier"]}
    }
  ]
}
